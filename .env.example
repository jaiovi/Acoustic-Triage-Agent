# The Replit workspace supplies its managed PostgreSQL connection automatically.
# For local Docker runs, replace this with a valid PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/acoustic_triage
PORT=5000

# Server-side key used by the Reson8 realtime WebSocket proxy.
RESON8_API_KEY=replace-me

# Optional comma-separated browser origins. Same-origin requests need no CORS entry.
CORS_ORIGIN=

# Used by the Docker image to serve the built Vite UI and API from one process.
WEB_DIST_DIR=artifacts/acoustic-triage-agent/dist/public
